name: Make Bilingual Book

on:
  workflow_dispatch:
    inputs:
      book_path:
        description: '电子书文件名 (例如: book.epub)'
        required: true
        default: 'test.epub'
      model:
        description: '使用的模型 (如 gemini / openai / google)'
        required: true
        default: 'gemini'
      language:
        description: '目标语言'
        required: true
        default: 'zh-hans'

jobs:
  translate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          pip install -r requirements.txt

      - name: Run translation
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
        run: |
          python make_book.py --book_name "${{ github.event.inputs.book_path }}" --model "${{ github.event.inputs.model }}" --language "${{ github.event.inputs.language }}"

      - name: Upload Bilingual Book
        uses: actions/upload-artifact@v3
        with:
          name: bilingual-book
          path: "*_bilingual.epub"
